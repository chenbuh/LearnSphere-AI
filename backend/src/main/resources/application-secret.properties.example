# 机密配置示例文件
# 使用说明：
# 1. 复制本文件为 application-secret.properties
# 2. 将真实账号、密码、密钥填入复制后的文件
# 3. application-secret.properties 已在 .gitignore 中忽略，不会提交到仓库
# 4. 如果启用了 Jasypt 加密，请同时提供环境变量 JASYPT_PASSWORD

# AI 配置
# DashScope / 百炼 API Key
ai.api-key=your-ai-api-key
# 可选：覆盖默认模型
# ai.model=qwen-turbo
# 可选：覆盖兼容接口地址
# ai.api-url=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# 数据库配置
spring.datasource.username=root
spring.datasource.password=your-db-password

# 可选：Redis 认证
# spring.redis.password=your-redis-password

# 易支付 / 七相聚合支付 在线收款
# epay.enabled=true
# epay.api-url=https://api.payqixiang.cn/
# epay.pid=1000
# epay.key=your-epay-merchant-key
# 异步通知必须公网可访问
# epay.notify-url=https://your-domain/api/payment/epay/notify
# 支付完成后跳回前端的结果页
# epay.return-url=https://your-domain/payment/result
# epay.sitename=LearnSphere
#
# 接口路径（一般无需修改，网关变更时用）
# epay.unified-order-path=mapi.php
# epay.query-path=api.php
#
# 说明：微信支付默认以 device=pc 调用统一下单，取回 qrcode 由前端自建
#   二维码收款窗口，用户在当前页面扫码，不跳转到支付平台页面。
#   微信内浏览器自动切换为 device=wechat（JSAPI），支付宝走 device=jump。

# 邮件服务（SMTP），用于注册 / 找回密码验证码和后台邮件通知
# QQ 邮箱：设置 → 账户 → 开启 POP3/SMTP 服务，生成「授权码」填到 password（不是 QQ 登录密码）
# 未配置 username 时邮件功能自动关闭，注册不强制验证码
# spring.mail.host=smtp.qq.com
# spring.mail.port=465
# spring.mail.protocol=smtps
# spring.mail.username=your-account@qq.com
# spring.mail.password=your-smtp-auth-code
# spring.mail.default-encoding=UTF-8
# spring.mail.properties.mail.smtp.auth=true
# spring.mail.properties.mail.smtp.ssl.enable=true
# spring.mail.properties.mail.smtp.connectiontimeout=10000
# spring.mail.properties.mail.smtp.timeout=10000
# spring.mail.properties.mail.smtp.writetimeout=10000
# 可选：发件人显示名称
# app.mail.sender-name=LearnSphere AI
