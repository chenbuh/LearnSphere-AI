<?xml version="1.0" encoding="UTF-8"?>
<!--
  LearnSphere 日志配置

  设计要点：
  1. 控制台 + 滚动文件双输出。控制台保留原有格式，宝塔/前台能看到；文件用于事后排查。
  2. 文件路径优先取 LOG_PATH 环境变量，未设置时落到 ./logs（相对进程工作目录）。
     宝塔部署时建议显式设置 LOG_PATH 到版本目录外的独立路径，避免发版时被覆盖。
  3. 按天 + 按大小滚动，默认保留 30 天 / 上限 5GB，防止磁盘被日志占满。
  4. 错误日志单独一份，排查时不用在混合日志里翻找。
  5. 生产（prod profile）用 INFO 级别，其它环境沿用 application.yml 的级别设置。

  注意：springProfile 之外不要再硬编码 com.learnsphere 的级别，
  否则会覆盖 application.yml / application-prod.yml 里的配置。
-->
<configuration scan="false">

    <!-- 日志根目录：优先 LOG_PATH 环境变量 -->
    <property name="LOG_PATH" value="${LOG_PATH:-./logs}"/>
    <property name="APP_NAME" value="learnsphere"/>

    <!-- 统一格式，与 application.yml 里的 console pattern 保持一致 -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{50} - %msg%n"/>

    <!-- ============ 控制台 ============ -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ============ 全量日志（按天 + 按大小滚动）============ -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archive/${APP_NAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ============ 错误日志（只记 ERROR，单独一份）============ -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}-error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archive/${APP_NAME}-error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>60</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--
      异步包装：避免日志 IO 阻塞业务线程。
      discardingThreshold=0 表示队列满时也不丢弃 WARN/ERROR（只丢 TRACE/DEBUG/INFO）。
      queueSize 默认 256，这里放大到 1024 应对突发流量。
    -->
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>false</neverBlock>
        <appender-ref ref="FILE"/>
    </appender>

    <appender name="ASYNC_ERROR_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>256</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>false</neverBlock>
        <appender-ref ref="ERROR_FILE"/>
    </appender>

    <!--
      降低噪音：这些框架的 DEBUG 日志量大且排查时基本无用。
      业务代码（com.learnsphere）的级别交给 application*.yml 控制，这里不写死。
    -->
    <logger name="org.apache.ibatis" level="INFO"/>
    <logger name="org.mybatis" level="INFO"/>
    <logger name="com.zaxxer.hikari" level="INFO"/>
    <logger name="io.lettuce" level="INFO"/>
    <logger name="io.netty" level="INFO"/>
    <logger name="org.springframework.web" level="INFO"/>

    <!-- 生产环境：整体 INFO，且不输出到控制台的重复内容 -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
            <appender-ref ref="ASYNC_ERROR_FILE"/>
        </root>
    </springProfile>

    <!-- 非生产环境：沿用 application.yml 的级别，同时写文件便于本地排查 -->
    <springProfile name="!prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
            <appender-ref ref="ASYNC_ERROR_FILE"/>
        </root>
    </springProfile>

</configuration>
