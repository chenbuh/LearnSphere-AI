# ============================================================================
# 安全修复（2026-03）：生产库导出与运行时快照绝不允许进入版本库
# 背景：backend/learnsphere_ai_production.sql 与 _backup_20260306.sql 曾随初始
# 提交推送到公开远端，内含全部用户邮箱、口令哈希与订单数据，构成数据外泄。
# 注意：本条规则只防「未来误提交」；历史中已存在的对象仍需用 git filter-repo 清除。
# ============================================================================

# 数据库导出（保留 schema / 迁移脚本）
*_backup_*.sql
*_production.sql
!backend/src/main/resources/**/*.sql
!backend/sql/**/*.sql

# Redis 持久化快照（含会话与缓存数据）
*.rdb
*.aof

# 运行时日志（可能含 SQL 明文与用户数据）
runtime.log
backend/runtime.log
*.log

# 审计产物（含漏洞验证脚本与证据，勿入库）
.ig5-audit/

# 词汇例句补全工具的中间产物（报告/断点文件）
backend/tools/.reports/
backend/tools/__pycache__/

# ============================================================================
# 工程收尾（2026-10）：以下规则用于阻断临时产物与本地审计输出回流
# ============================================================================

# 前端构建产物（由 npm run build:frontend / build:admin 生成，不入库）
backend/src/main/resources/static/dist/
backend/src/main/resources/static/admin/

# 本地审计与验证产物（含截图、基线数据、临时编译类）
.a11y/
.a11y_scan/
.verify/
.tmp-theme-audit/
verification/

# Python 中间产物
__pycache__/
*.pyc
backend/.tts-cache/
backend/.pip-tmp/

